# Main service
APP_PORT=4330
APP_DATA_DIR=app/data
DEFAULT_MAX_CALLS=12

# Text generation (required for research, writing and review)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Image generation (required for comic covers and illustrations)
ARK_API_KEY=
ARK_IMAGE_MODEL=doubao-seedream-5-0-flash-260915

# Optional local integrations
OPENCLAW_PATH=app/node_modules/openclaw/openclaw.mjs
EGO_BROWSER_COMMAND=ego-browser
PAPERCLIP_ENABLED=false
PAPERCLIP_BASE_URL=http://127.0.0.1:4320/api
PAPERCLIP_PORT=4320
PAPERCLIP_CONFIG=research/runtime-lab/state/paperclip/instances/default/config.json
